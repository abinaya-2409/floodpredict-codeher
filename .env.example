# GEMINI_API_KEY - server-side only, used by /api/gemini/* routes.
# Without it those routes return a clearly-labelled sample response
# ({"sample": true, "aiAvailable": false}) rather than failing.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_MAPTILER_KEY - optional. When set, the Situational theme upgrades its
# basemap to MapTiler terrain relief. Light and Blackout themes use CARTO's
# keyless basemaps and need no configuration at all.
VITE_MAPTILER_KEY=""

# APP_URL - deployment origin, used for self-referential links.
APP_URL="MY_APP_URL"
