# The incident briefing needs NO key. It is composed in the browser from this
# application's own flood model, so it always renders. The assistant's Report
# and Summarise are the same: written by the app, no key, works offline.
#
# One key here serves every visitor to the site, so nobody has to bring their
# own. It enables the "Rewrite as prose" button and the assistant's open
# conversation - the parts that need a model. Both providers serve open-weight
# models on a free tier and both are OpenAI-compatible.
#
#   LLM_PROVIDER=groq        -> console.groq.com, key starts gsk_
#   LLM_PROVIDER=openrouter  -> openrouter.ai,    key starts sk-or-
#
# LLM_PROVIDER can be left empty: the key's prefix decides which one it is.
LLM_PROVIDER=""
LLM_API_KEY=""

# The shared allowance for the assistant, since one key serves everyone and
# the tier behind it is free. All optional; these are the defaults.
#
#   CHAT_RATE_PER_IP   requests a minute from one address     (default 8)
#   CHAT_RATE_GLOBAL   requests a minute across the whole site (default 60)
#   CHAT_RATE_DAILY    requests a day across the whole site    (default 1500)
#
# Counted per serverless instance, not globally - see api/_rateLimit.ts for
# why that is a deliberate trade rather than an oversight.
CHAT_RATE_PER_IP=""
CHAT_RATE_GLOBAL=""
CHAT_RATE_DAILY=""

# Every answer the assistant gives about a ward is checked against the app's
# own numbers, and one that gets a figure wrong is sent back to be corrected.
# These two decide where that record is kept. Without them the findings go to
# the server log instead, and the checking still happens either way.
#
# Create a Supabase project, run supabase/assistant_errors.sql in its SQL
# editor, then take the URL and the service_role key from Project Settings ->
# API. The service role key, not the anon key: this table is written by the
# server and should not be writable by anything holding the public key.
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""

# VITE_MAPTILER_KEY - optional. When set, the Situational theme upgrades its
# basemap to MapTiler terrain relief. Light and Blackout themes use CARTO's
# keyless basemaps and need no configuration at all.
VITE_MAPTILER_KEY=""

# APP_URL - deployment origin, used for self-referential links.
APP_URL="MY_APP_URL"

# EMAIL & SMS NOTIFICATIONS (Nodemailer OTP delivery)
# Option 1: Gmail App Password (Free and easiest for personal testing)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Option 2: Custom SMTP (Brevo, SendGrid, Mailgun, AWS SES, or corporate relay)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
